// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init


generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User{
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String   
  name      String?
  playlist  Playlist[]
  rooms     Rooms?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Album{
id          Int     @id @default(autoincrement())
name        String  
releasedate String  
artist_id    String
artist_name  String
image       String
zip         String
shorturl    String
shareurl    String
zip_allowed Boolean
createdAt   DateTime @default(now())
updatedAt   DateTime @updatedAt
}


model Playlist{

id              Int     @id @default(autoincrement())
playlist_name   String
private         Boolean
userId          Int
user            User @relation(fields: [userId],references: [id],onDelete: Cascade)
playlistSongs   PlaylistSongs[]
createdAt       DateTime  @default(now())
updatedAt       DateTime  @updatedAt

}



model Songs{
id              Int     @id @default(autoincrement())
name            String
duration        Int
artist_id       String
artist_name     String
artist_idstr    String
album_name      String
album_id        String
license_ccurl   String
position        Int
releasedate     String
album_image     String
audio           String
audiodownload   String
prourl          String
shorturl        String
shareurl        String
image           String
audiodownload_allowed  Boolean
content_id_free        Boolean
playlistSongs    PlaylistSongs[]

createdAt       DateTime  @default(now())
updatedAt       DateTime  @updatedAt

}

model PlaylistSongs{
  playlist    Playlist @relation(fields: [playlistId], references: [id],onDelete:Cascade)
  playlistId  Int
  song        Songs    @relation(fields: [songId], references: [id])
  songId      Int @unique
  addedAt     DateTime @default(now())
  position    Int?
  @@id([playlistId,songId])
}


model Rooms{
  roomId      Int @id 
  limit       Int
  adminPlay   Boolean
  isChatOpen  Boolean
  userId      Int @unique
  user        User @relation(fields: [userId],references: [id])
  createdAt       DateTime  @default(now())
}
